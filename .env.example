# Jev: usa UNA de las dos claves.
# Clave de la consola de TypeSafe (API directa, api.typesafe.ai)
TYPESAFE_API_KEY=
# o clave de Vercel AI Gateway (empieza por vck_)
AI_GATEWAY_API_KEY=

# LLM tradicional: cualquier API compatible con /chat/completions de OpenAI.
# Por defecto DeepSeek (DEEPSEEK_API_KEY también sirve como LLM_API_KEY).
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Nombre que aparece en pantalla
LLM_NAME=DeepSeek
# Razonamiento del LLM: off (por defecto, la forma más rápida), low (el mínimo), high o max.
# Con razonamiento acierta más pero tarda mucho más.
LLM_THINKING=off
# Campos extra para el cuerpo de la petición, en JSON (p. ej. {"reasoning_effort":"minimal"})
LLM_EXTRA=

# Precios en USD por millón de tokens (para el contador de coste)
LLM_PRICE_IN=0.15
LLM_PRICE_CACHED=0.003
LLM_PRICE_OUT=0.6
JEV_PRICE_IN=0.042
